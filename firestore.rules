rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function validEntry(d, uid) {
      return d.keys().hasOnly(['uid', 'name', 'score', 'time', 'moves', 'day', 'week', 'month', 'at'])
        && d.uid == uid
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.score is int && d.time is int && d.moves is int
        && d.time >= 20 && d.time <= 86400
        && d.moves >= 52 && d.moves <= 5000
        && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.week is string && d.week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.month is string && d.month == d.day[0:7]
        // Bests are independent. The score can never exceed what the best time and fewest moves allow.
        && d.score >= 0 && d.score <= 10000
        && (d.score == 0 || d.score <= 10000 - d.time * 10 - d.moves * 20)
        && d.at == request.time;
    }

    // One document per player per day. Anyone can read; only the owner can write, and personal bests can only improve.
    match /scores/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && id == request.auth.uid + '_' + request.resource.data.day
        && validEntry(request.resource.data, request.auth.uid);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && validEntry(request.resource.data, request.auth.uid)
        && request.resource.data.day == resource.data.day
        && request.resource.data.score >= resource.data.score
        && request.resource.data.time <= resource.data.time
        && request.resource.data.moves <= resource.data.moves;
      allow delete: if false;
    }
  }
}
